context timeout=120000
# Mirrors e2e/flows/signup.yml. SIGNUP_EMAIL and SIGNUP_PASSWORD are generated by scripts/utils/run_agent_device_suite
# @launch useMaestroInit=true shouldSignOut=true
open ${APP_ID}
wait 'label="Sign up or log in" || text="Sign up or log in"' 30000
# The heading can appear before the field is ready to edit
wait 'label="Email Input"' 15000
fill 'label="Email Input"' "${SIGNUP_EMAIL}"
press 'label="Continue" || text="Continue"'
wait 'id="password"' 15000
# iOS can't fill (clear and replace) a secure text field, so focus it and type into the empty field
press 'id="password"'
type "${SIGNUP_PASSWORD}"
press 'label="Continue" || text="Continue"'
# The password screen also says "Welcome to Artsy", so wait for the name field itself. It has no
# accessibility label; "First and last name" is its placeholder, which matches as text while it's empty.
wait 'text="First and last name"' 15000
fill 'text="First and last name"' "Test McTest"
press 'label="Accept terms and privacy policy checkbox"'
press 'label="Continue" || text="Continue"'
wait 'label="Where are you in your art collecting journey?" || text="Where are you in your art collecting journey?"' 30000
close
