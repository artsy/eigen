context timeout=240000
# Mirrors e2e/flows/deeplinks.yml. Each deeplink is opened against a closed app to exercise cold-start link handling.
# @launch useMaestroInit=true email=${EMAIL} password=${PASSWORD}
open ${APP_ID}
wait 'id="search-button"' 30000
close

# Artist
open ${APP_ID} "https://artsy.net/artist/kaws"
wait 'label="KAWS" || text="KAWS"' 20000
close

# Auction highlights (Braze click-tracking link)
open ${APP_ID} "https://click.artsy.net/f/a/epPWiX0dJaHHMiXAnSrzSg~~/AAQRxQA~/RgRj95QSP0SQaHR0cHM6Ly93d3cuYXJ0c3kubmV0L2NvbGxlY3Rpb24vYXVjdGlvbi1oaWdobGlnaHRzP3V0bV9zb3VyY2U9YnJhemUmdXRtX21lZGl1bT1lbWFpbCZ1dG1fY2FtcGFpZ249bnRmJnV0bV90ZXJtPTYyMTRmYjlkZWI0ZWZkN2RiNjBjZTcwNDk1NWU4NDQ1VwNzcGNCCmIFEg8VYlEJKGBSEmJyaWJlY2sxQGdtYWlsLmNvbVgEAAAAfw~~"
wait 'label="Highlights at Auction This Week" || text="Highlights at Auction This Week"' 20000
close

