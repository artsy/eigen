context timeout=300000
# @title My Collection - Add and Delete Artwork
# Signs up a new account (the same steps as signup), adds an artwork to My Collection (artist search, skip the
# artwork search, title and medium), checks it shows in the collection, then deletes it from the edit form.
# A new account starts with an empty collection, so an attempt that stops halfway can't leave a work behind that
# breaks the next one. SIGNUP_EMAIL and SIGNUP_PASSWORD are generated by scripts/utils/run_e2e_suite, new for
# every attempt.
# @launch useE2EInit=true shouldSignOut=true
open ${APP_ID}
# The first launch on a cold CI simulator can take over a minute
wait 'label="Sign up or log in" || text="Sign up or log in"' 90000
# The heading can appear before the field is ready to edit
wait 'label="Email Input"' 15000
fill 'label="Email Input"' "${SIGNUP_EMAIL}"
press 'label="Continue" || text="Continue"'
wait 'id="password"' 15000
# The email screen can still be on screen during the transition, with its own Continue button
wait absent 'label="Email Input"' 10000
# iOS can't fill (clear and replace) a secure text field, so focus it and type into the empty field
press 'id="password"'
type "${SIGNUP_PASSWORD}"
press 'label="Continue" || text="Continue"'
# The password screen also says "Welcome to Artsy", so wait for the name field itself. It has no
# accessibility label; "First and last name" is its placeholder, which matches as text while it's empty.
wait 'text="First and last name"' 15000
wait absent 'id="password"' 10000
fill 'text="First and last name"' "Test McTest"
# Filling the field raises the keyboard, which covers the Continue below it, and agent-device
# refuses to tap an element behind the keyboard ("cannot be tapped safely"). `keyboard dismiss`
# can't close it: the iOS keyboard exposes no hide key, so it only succeeds when the keyboard is
# already down. The field's return key is "done" with blurOnSubmit, so pressing it closes the
# keyboard. Its onSubmitEditing only submits once the terms are accepted, so running this before the
# checkbox just highlights them, it doesn't submit.
keyboard return
press 'label="Accept terms and privacy policy checkbox"'
# This screen's Continue has its own accessibility label, so it can't also match the password
# screen's Continue while both are on screen during the transition
press 'label="Continue to complete sign up"'
# Onboarding: the answers fade in after the question settles. An experienced collector skips the
# rest of the quiz and goes to the follow-artists step.
wait 'label="I’m an experienced collector (4+ works)" || text="I’m an experienced collector (4+ works)"' 15000
press 'label="I’m an experienced collector (4+ works)" || text="I’m an experienced collector (4+ works)"'
press 'role="button" label="Continue"'
wait 'role="button" label="Skip to home"' 30000
press 'role="button" label="Skip to home"'
wait 'id="search-button"' 30000

# Profile tab → My Collection
press 'id="bottom-tab-profile"'
wait 'id="account-card"' 30000
press 'id="account-card"'
wait 'label="Add to My Collection"' 30000
press 'label="Add to My Collection"'

# Step 1: pick a real Artsy artist
wait 'text="Search for artists on Artsy"' 15000
fill 'text="Search for artists on Artsy"' "KAWS"
wait 'id="autosuggest-search-result-KAWS"' 15000
press 'id="autosuggest-search-result-KAWS"'

# Step 2: KAWS has artworks on Artsy, so the artwork search comes next. Skip it.
wait 'text="Select an Artwork"' 15000
wait 'role="button" label="Skip"' 15000
press 'role="button" label="Skip"'

# Step 3: the main form. Title and medium are the only required fields.
wait 'label="Title"' 15000
wait absent 'text="Select an Artwork"' 10000
fill 'label="Title"' "E2E Test Artwork"
press 'id="CategorySelect"'
wait 'text="Painting"' 10000
press 'text="Painting"'
wait absent 'id="select-close-button"' 10000
press 'role="button" label="Complete"'

# Saving holds a modal for at least 4.5s (2.5s insights + 2s market data), then closes the form
wait 'id="saving-artwork-modal"' 10000
wait absent 'id="saving-artwork-modal"' 60000
# Grid items are labelled with their caption: artist, title and date (none here)
wait 'label="KAWS, E2E Test Artwork"' 30000

# Open it, then delete it from the edit form
press 'label="KAWS, E2E Test Artwork"'
wait 'label="Edit" || text="Edit"' 30000
press 'label="Edit" || text="Edit"'
wait 'label="Title"' 30000
scroll down --until 'label="Delete artwork"'
press 'label="Delete artwork"'
# The palette Button exposes its inner view with the same label, so match the button role only
wait 'role="button" label="Delete Artwork"' 15000
press 'role="button" label="Delete Artwork"'

# Deleting closes the edit form and the artwork screen, back to My Collection. Check the work is gone.
wait 'label="Add to My Collection"' 30000
wait absent 'label="KAWS, E2E Test Artwork"' 30000
close ${APP_ID}
