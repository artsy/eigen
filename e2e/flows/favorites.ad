context timeout=300000
# @title Favorites - Save Artwork and Follow Artist
# Signs up a new account (the same steps as signup), saves an artwork and follows its artist, checks both show in
# Favorites, then unsaves and unfollows and checks Favorites again.
# A fresh account starts with nothing saved or followed, so an attempt that stops halfway can't break the next one.
# SIGNUP_EMAIL and SIGNUP_PASSWORD are generated by scripts/utils/run_e2e_suite, new for every attempt.
# Uses "Maestro Test Artwork, 2025" by "Test Artist", the same staging test data as deeplink-email. The work is sold,
# so its save button stays "Save artwork" (a lot in an open sale would read "Watch lot"), and a new account has no
# custom lists, so a save goes straight to Saved Artworks instead of opening the list picker.
# @launch useE2EInit=true shouldSignOut=true
open ${APP_ID}
# The first launch on a cold CI simulator can take over a minute
wait 'label="Sign up or log in" || text="Sign up or log in"' 90000
# The heading can appear before the field is ready to edit
wait 'label="Email Input"' 15000
fill 'label="Email Input"' "${SIGNUP_EMAIL}"
press 'label="Continue" || text="Continue"'
wait 'id="password"' 15000
# The email screen can still be on screen during the transition, with its own Continue button
wait absent 'label="Email Input"' 10000
# iOS can't fill (clear and replace) a secure text field, so focus it and type into the empty field
press 'id="password"'
type "${SIGNUP_PASSWORD}"
press 'label="Continue" || text="Continue"'
# The password screen also says "Welcome to Artsy", so wait for the name field itself. It has no
# accessibility label; "First and last name" is its placeholder, which matches as text while it's empty.
wait 'text="First and last name"' 15000
wait absent 'id="password"' 10000
fill 'text="First and last name"' "Test McTest"
# Filling the field raises the keyboard, which covers the Continue below it, and agent-device
# refuses to tap an element behind the keyboard ("cannot be tapped safely"). `keyboard dismiss`
# can't close it: the iOS keyboard exposes no hide key, so it only succeeds when the keyboard is
# already down. The field's return key is "done" with blurOnSubmit, so pressing it closes the
# keyboard. Its onSubmitEditing only submits once the terms are accepted, so running this before the
# checkbox just highlights them, it doesn't submit.
keyboard return
press 'label="Accept terms and privacy policy checkbox"'
# This screen's Continue has its own accessibility label, so it can't also match the password
# screen's Continue while both are on screen during the transition
press 'label="Continue to complete sign up"'
# Onboarding: the answers fade in after the question settles. An experienced collector skips the
# rest of the quiz and goes to the follow-artists step.
wait 'label="I’m an experienced collector (4+ works)" || text="I’m an experienced collector (4+ works)"' 15000
press 'label="I’m an experienced collector (4+ works)" || text="I’m an experienced collector (4+ works)"'
press 'role="button" label="Continue"'
wait 'role="button" label="Skip to home"' 30000
press 'role="button" label="Skip to home"'
wait 'id="search-button"' 30000

# Save the artwork. https links open the app directly; artsy:// links make iOS ask first (see share.ios.ad).
open "https://artsy.net/artwork/68f8d42e48a62efeaf971460"
open ${APP_ID}
wait 'label="Maestro Test Artwork, 2025"' 30000
wait 'label="Save artwork"' 15000
press 'label="Save artwork"'
wait 'label="Unsave artwork"' 15000

# Follow its artist. Palette's Button repeats its label on an inner view, so match the button role.
press 'label="Test Artist"'
wait 'role="button" label="Follow Test Artist"' 30000
press 'role="button" label="Follow Test Artist"'
wait 'role="button" label="Following Test Artist"' 10000
# The follow mutation is debounced by 350ms and leaving the screen cancels it, so stay until it's sent
wait 2000

# Both show in Favorites
press 'label="Favorites"'
wait 'label="Follows"' 30000
press 'label="Follows"'
# Each row's follow button is labelled with the artist's name. The row's own label differs by platform (iOS
# merges the name, nationality and button; Android doesn't), so check the button.
wait 'role="button" label="Following Test Artist"' 30000
press 'label="Saves"'
wait 'label="Saved Artworks"' 30000
press 'label="Saved Artworks"'
# The grid item's label also reads the gallery, price and signals, so match its title testID
wait 'id="artworkGridItem-Maestro Test Artwork"' 30000

# Clean up from the saved list: open the artwork, unsave it, then unfollow its artist
press 'id="artworkGridItem-Maestro Test Artwork"'
wait 'label="Unsave artwork"' 30000
press 'label="Unsave artwork"'
wait 'label="Save artwork"' 15000
press 'label="Test Artist"'
wait 'role="button" label="Following Test Artist"' 30000
press 'role="button" label="Following Test Artist"'
wait 'role="button" label="Follow Test Artist"' 10000
wait 2000

# Tapping the selected tab pops back to the Favorites screen. Unfollowed artists stay listed until a refetch, with
# their button back to "Follow"; the unsaved artwork leaves Saved Artworks.
press 'label="Favorites"'
wait 'label="Follows"' 30000
press 'label="Follows"'
wait 'role="button" label="Follow Test Artist"' 30000
press 'label="Saves"'
wait 'label="Saved Artworks"' 30000
press 'label="Saved Artworks"'
# A new account's list is empty once the artwork is unsaved, which shows an empty state instead of the Sort
# button. Until the list refetches it can still show the grid, so wait for either before checking the artwork's gone.
wait 'label="Sort" || label="Keep track of artworks you love" || text="Keep track of artworks you love"' 30000
wait absent 'id="artworkGridItem-Maestro Test Artwork"' 30000
close ${APP_ID}
