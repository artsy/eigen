#!/bin/bash
set -euo pipefail

if [ "$#" -ne 1 ]; then
    echo "Usage: $0 <commit-hash>" >&2
    exit 1
fi

commit_hash=$1

generate_fingerprint() {
    npx @expo/fingerprint fingerprint:generate | jq -r '.hash'
}

initial_fingerprint=$(generate_fingerprint) || {
    echo "❌ Error generating initial native fingerprint" >&2
    exit 2
}

echo "Initial native fingerprint: $initial_fingerprint"

# -x records "(cherry picked from commit <sha>)" in the message, so the published
# commit always points back to the fix that was reviewed and merged on main.
git cherry-pick -x "$commit_hash" || {
    echo "❌ Error cherry-picking commit: $commit_hash" >&2
    echo "   Resolve the conflict, then 'git cherry-pick --continue' and, if you came from" >&2
    echo "   start-hotfix, './scripts/deploys/expo-updates/start-hotfix <version> --continue'." >&2
    echo "   Or give up with 'git cherry-pick --abort'." >&2
    exit 3
}

final_fingerprint=$(generate_fingerprint) || {
    echo "❌ Error generating final native fingerprint" >&2
    exit 4
}

echo "Final native fingerprint: $final_fingerprint"

if [ "$initial_fingerprint" != "$final_fingerprint" ]; then
    echo -e "\033[0;31m❌ Native code changed! You cannot use Expo Updates for this hotfix.\033[0m" >&2
    echo "   The commit is applied locally, but it must not be shipped over the air." >&2
    echo "   Drop it with 'git reset --hard HEAD~1' and follow the native hotfix process instead:" >&2
    echo "   docs/deploy_a_hotfix.md" >&2
    exit 5
fi

echo "✅ Fix applied and native code did not change — you can continue with the Expo Updates release process."
